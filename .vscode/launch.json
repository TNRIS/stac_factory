    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug testimport",
            "type": "debugpy",
            "request": "launch",
            "module": "tests.testimport",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
        },
        {
            "name": "debug testbulk",
            "type": "debugpy",
            "request": "launch",
            "module": "tests.testbulk",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        }            
    ]
}